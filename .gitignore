# =====================================================================
# OpenAQ Acquisition Pipeline .gitignore
# Strictly excludes large data containers, manifests, credentials & logs
# =====================================================================

# Large Binary Data Containers & Manifests (Stored in External Backup)
*.tar
*.idx
*.csv.gz
raw/
data/

# Operational Logs & Concurrency Locks
logs/
*.log
*.runner.log
tmp/
*.lock

# Secrets & Security Credentials (NEVER COMMIT)
.env
.env.*
*.env
.ssh/
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Python Environment & Bytecode
venv/
env/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Operating System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Downstream Database Artifacts (Reserved for Separate Project)
*.sql
db_exports/
demo_data/
demo_figures/
extracted_samples/
*.docx
